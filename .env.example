PORT=3780
MATRIX_HOMESERVER_URL=https://matrix.example.org
MATRIX_USERNAME=botuser
MATRIX_PASSWORD=secret
# Секрет в пути: POST /<ACCESS_TOKEN>/sendMessage. Для совместимости с
# Alertmanager должен начинаться с bot — он собирает адрес как
# <api_url>/bot<bot_token>/sendMessage
ACCESS_TOKEN=bot7835739915:AAGcKWlVKR123
# Комната по умолчанию — для отправителей, которые не умеют передавать её id
# (Alertmanager держит chat_id целым числом). Идентификатор или алиас.
MATRIX_DEFAULT_ROOM=#alarm:example.org
# Несколько комнат при числовых chat_id: тревоги в одну, отчёты в другую
# MATRIX_ROOM_MAP={"-1001234567":"!abc:example.org","-1007654321":"!def:example.org"}
# MATRIX_TOKEN_CACHE_PATH=/var/lib/matrix-sender/token.json
# MATRIX_TOKEN_CACHE_TTL_DAYS=364
